# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password HRDD uses to sign in to /admin
HRDD_ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie — any long random string
# (e.g. output of: openssl rand -hex 32)
HRDD_SESSION_SECRET=
